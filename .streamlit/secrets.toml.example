# Copia este archivo como .streamlit/secrets.toml (no se sube a GitHub).
# En Streamlit Cloud pega este mismo contenido en Settings > Secrets.

SPREADSHEET_ID = "1C24HefzSLoDiN5TlQ2LKTv4Ot_ktq5SHwEeXjXekofU"

# URL pública de la app (sin "/" al final). Se usa para armar el link del artista.
# En local puedes dejarla vacía.
BASE_URL = ""

# Datos del responsable que aparecen en la política de datos
RESPONSABLE_NOMBRE = "Hayaku Lab"
RESPONSABLE_EMAIL = "contacto@tudominio.com"

# Credenciales del service account. En local basta con dejar
# service_account.json en la raíz del repo. En Streamlit Cloud copia aquí
# los campos del JSON:
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
